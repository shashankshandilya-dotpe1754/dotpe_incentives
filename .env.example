# Copy to .env and fill in. Never commit .env or the service account key.

SECRET_KEY=replace-with-a-long-random-string

# From the sheet URL: docs.google.com/spreadsheets/d/<THIS PART>/edit
SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json

# Google sign-in (OAuth client, type "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_DOMAIN=dotpe.in

# Salary entry: set to 0 after the deadline
EDITS_OPEN=1
MAX_MONTHLY_SALARY=1000000

# Optional: exact tab names, if the automatic matching ever picks the wrong tab
# MAIN_TAB_NAME=Quaterly Incentive(SMB Faming, Inbound, Enterprise)
# COMBINED_TAB_NAME=Combined ACH (July, August, September'2026)
# REMAINING_TAB_NAME=Remaining ACH (April, May, June'2026)

# Local testing only
# COOKIE_SECURE=0
# DEMO_MODE=1
